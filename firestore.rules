rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── helpers ────────────────────────────────────────────────────────────────
    function authed() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return authed() && userDoc().role == 'admin';
    }

    function isActiveMember() {
      return authed()
          && userDoc().role == 'member'
          && userDoc().status == 'active';
    }

    function isOwner(uid) {
      return authed() && request.auth.uid == uid;
    }

    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // ── /users/{uid} ───────────────────────────────────────────────────────────
    match /users/{uid} {
      // Any authenticated user can read their own profile; admins see all
      allow read: if isOwner(uid) || isAdmin();
      // New sign-ups create their own doc with role='member' only
      allow create: if isOwner(uid)
                    && request.resource.data.role == 'member'
                    && request.resource.data.status == 'pending';
      // Members can update their own non-privileged fields; admin can update anything
      allow update: if isAdmin()
                    || (isOwner(uid) && !onlyChanges(['role', 'status']));
      allow delete: if isAdmin();
    }

    // ── /appointments/{id} ────────────────────────────────────────────────────
    match /appointments/{id} {
      allow read: if isAdmin()
                  || (isActiveMember() && resource.data.memberId == request.auth.uid);
      // Members can only create pending appointments for themselves
      allow create: if isActiveMember()
                    && request.resource.data.memberId == request.auth.uid
                    && request.resource.data.status == 'pending';
      // Only admin can confirm / reject
      allow update, delete: if isAdmin();
    }

    // ── /dailyPrayers/{id} ────────────────────────────────────────────────────
    match /dailyPrayers/{id} {
      allow read:  if authed();
      allow write: if isAdmin();
    }

    // ── /prayerLogs/{id} ──────────────────────────────────────────────────────
    match /prayerLogs/{id} {
      allow read: if isAdmin()
                  || (authed() && resource.data.userId == request.auth.uid);
      allow create: if isActiveMember()
                    && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ── /attendance/{id} ──────────────────────────────────────────────────────
    match /attendance/{id} {
      allow read:  if authed();
      // Admin manages meetings; active members can add themselves to attendees
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
                    || (isActiveMember() && onlyChanges(['attendees']));
    }

    // ── /blogPosts/{id} ───────────────────────────────────────────────────────
    match /blogPosts/{id} {
      // Published posts are public; drafts are admin-only
      allow read:  if resource.data.status == 'published' || isAdmin();
      // Members can comment; only admin can create / fully update posts
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
                    || (isActiveMember() && onlyChanges(['comments']));
    }

    // ── /events/{id} ──────────────────────────────────────────────────────────
    match /events/{id} {
      allow read:   if true;
      allow create, delete: if isAdmin();
      // Active members can update only the rsvps field (self-register)
      allow update: if isAdmin()
                    || (isActiveMember() && onlyChanges(['rsvps']));
    }

    // ── /gallery/{id} ─────────────────────────────────────────────────────────
    match /gallery/{id} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ── /messages/{id} ────────────────────────────────────────────────────────
    match /messages/{id} {
      allow read: if isAdmin()
                  || (isActiveMember()
                      && (resource.data.senderId == request.auth.uid
                          || resource.data.receiverId == request.auth.uid));
      allow create: if isActiveMember()
                    && request.resource.data.senderId == request.auth.uid;
      // Recipient can only mark as read
      allow update: if isAdmin()
                    || (authed()
                        && resource.data.receiverId == request.auth.uid
                        && onlyChanges(['read']));
      allow delete: if isAdmin();
    }

    // ── /testimonies/{id} ─────────────────────────────────────────────────────
    match /testimonies/{id} {
      allow read: if resource.data.status == 'published'
                  || isAdmin()
                  || (authed() && resource.data.authorId == request.auth.uid);
      // Members submit with status='pending'; admin approves
      allow create: if isActiveMember()
                    && request.resource.data.authorId == request.auth.uid
                    && request.resource.data.status == 'pending';
      // Authors can edit their pending testimonies (not status/likes)
      allow update: if isAdmin()
                    || (isOwner(resource.data.authorId)
                        && resource.data.status == 'pending'
                        && !request.resource.data.diff(resource.data)
                              .affectedKeys().hasAny(['status', 'likes']));
      allow delete: if isAdmin();
    }

    // ── /bibleStudies/{id} ────────────────────────────────────────────────────
    match /bibleStudies/{id} {
      allow read:  if authed();
      allow create, delete: if isAdmin();
      // Members can join (add themselves to members[])
      allow update: if isAdmin()
                    || (isActiveMember() && onlyChanges(['members']));
    }

    // ── /notifications/{id} ───────────────────────────────────────────────────
    match /notifications/{id} {
      allow read: if isAdmin()
                  || (authed() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin();
      // Users can only mark their own notifications as read
      allow update: if isAdmin()
                    || (authed()
                        && resource.data.userId == request.auth.uid
                        && onlyChanges(['read']));
      allow delete: if isAdmin();
    }

    // ── /challenges/{id} ──────────────────────────────────────────────────────
    match /challenges/{id} {
      allow read:   if authed();
      allow create, delete: if isAdmin();
      // Members can join challenges (add themselves to participants[])
      allow update: if isAdmin()
                    || (isActiveMember() && onlyChanges(['participants']));
    }
  }
}
