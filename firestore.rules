rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'super_admin'];
    }

    function isSuperAdmin() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin';
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // USERS
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isSuperAdmin();
    }

    // APPOINTMENTS
    match /appointments/{doc} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // DAILY PRAYERS
    match /dailyPrayers/{doc} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // PRAYER LOGS
    match /prayerLogs/{doc} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // ATTENDANCE
    match /attendance/{doc} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // CHECK INS
    match /checkIns/{doc} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // BLOG POSTS
    match /blogPosts/{doc} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // EVENTS
    match /events/{doc} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // GALLERY
    match /gallery/{doc} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // MESSAGES / CONVERSATIONS
    match /conversations/{doc} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /conversations/{convId}/messages/{msgId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // TESTIMONIALS
    match /testimonials/{doc} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // BIBLE STUDY
    match /bibleStudy/{doc} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // NOTIFICATIONS
    match /notifications/{doc} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // CHALLENGES
    match /challenges/{doc} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // CONTACT MESSAGES
    match /messages/{doc} {
      allow read: if isAdmin();
      allow create: if true;
    }
  }
}
