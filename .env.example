# ─── Firebase Client SDK (Next.js web app) ───────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ─── Firebase Admin SDK (seed script & server-side operations) ────────────────
# Get from: Firebase Console → Project Settings → Service Accounts
# → Generate new private key (save as scripts/service-account.json), OR set:
FIREBASE_ADMIN_PROJECT_ID=your_project_id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ─── Cloudinary (replaces Firebase Storage for file uploads) ─────────────────
# Get from: cloudinary.com → Dashboard
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# ─── Auth ────────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=your_nextauth_secret_min_32_chars
NEXTAUTH_URL=http://localhost:3000

# ─── Mobile (apps/mobile/.env) ───────────────────────────────────────────────
# EXPO_PUBLIC_FIREBASE_* — same values as the NEXT_PUBLIC_FIREBASE_* above.
# Deployed web app URL; the mobile app uses its /api/upload and /api/push routes.
# EXPO_PUBLIC_API_URL=https://your-app.vercel.app
#
# The FIREBASE_ADMIN_* values above must also be set on Vercel for push
# notifications (/api/push) to work.

# ─── Scripts ─────────────────────────────────────────────────────────────────
# Shared password for accounts created by scripts/create-test-users.ts and seed.ts
TEST_USER_PASSWORD=
